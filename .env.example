# ME Assistant configuration.
# Copy this file to ".env" and paste your keys below. Nothing here leaves your
# computer. You can also edit all of this from the API KEYS button in the app.

# --- Gemini (free tier, but a small daily allowance) ---------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (free tier, runs open models very fast; used first) ------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (paid, only used if you approve a switch) --------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Anthropic (paid, only used if you approve a switch) -----------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Fallback order ------------------------------------------------------
# Providers are tried left to right. Free tiers are used while they last;
# moving to any paid provider always asks you first.
LLM_CHAIN=groq,gemini,openai,anthropic

# --- Free tier limits ----------------------------------------------------
# IMPORTANT: these are defaults, not truths. Free-tier limits are specific to
# the model AND your account, and published figures disagree with each other.
# Check your provider console and correct these here or in the app's settings
# panel. Getting them wrong is not fatal -- the app also reacts to real 429
# responses -- but accurate values avoid wasted requests.
#
# Values below were observed in August 2026:
GEMINI_FREE_RPD=20          # gemini-2.5-flash
GEMINI_FREE_RPM=10
GEMINI_FREE_TPM=250000
GEMINI_FREE_TPD=0           # 0 = no known daily token cap
GROQ_FREE_RPD=1000          # llama-3.3-70b-versatile
GROQ_FREE_RPM=30
GROQ_FREE_TPM=6000          # tokens per minute
GROQ_FREE_TPD=100000        # tokens per DAY -- this is the limit that actually binds.
                            # At ~2.3k tokens a question that is ~20 questions/day.
                            # Set to 0 if your account has no daily token cap.

# Requests are paced locally against the per-minute limits above, so a busy
# minute never turns into a paid prompt. If every free tier is busy, this is
# how long the app will wait for capacity before asking you about paying.
MAX_FREE_WAIT_SECONDS=25

# Optional: pace a paid provider too, e.g. OPENAI_RPM=60. Off by default.
#OPENAI_RPM=

# --- Conversation length -------------------------------------------------
# The whole history is re-sent every turn, so tokens grow quadratically with
# conversation length. This caps how many turns are re-sent. Lower it to get
# more questions out of a daily token budget; 0 disables trimming.
MAX_HISTORY_TURNS=10

# Set to true if you have billing enabled for that provider. It then counts as
# a paid provider and will also ask before it is used.
GEMINI_BILLING_ENABLED=false
GROQ_BILLING_ENABLED=false
