.env
.env.*
!.env.example

# macOS
.DS_Store

# FUSE artefacts: a file deleted while still open gets renamed to this
# instead of being unlinked. They are orphaned data, never source.
.fuse_hidden*

# Node (UI test dependencies)
node_modules/

# IDEs
.vscode/
.idea/
